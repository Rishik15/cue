{
  "name": "cue",
  "version": "0.3.0",
  "description": "A utility belt for Windows: dictation, text tools, screen text capture, a dictionary, snippets and notes in one small tray app.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rishik15/cue.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "lint": "eslint src --max-warnings 0",
    "check": "tsc --noEmit && eslint src --max-warnings 0 && node scripts/check-size.mjs && node scripts/check-themes.mjs",
    "size": "node scripts/check-size.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@kobalte/core": "^0.13.14",
    "@tauri-apps/api": "^2",
    "lenis": "1.3.26",
    "lucide-solid": "^1.52.0",
    "solid-js": "^1.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-plugin-solid": "^0.18.1",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.11.12"
  },
  "author": "Rishik",
  "packageManager": "pnpm@12.10.1"
}
