{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "preview",
  "description": "The preview window: its own commands and the settings read for the theme, nothing else",
  "windows": [
    "preview"
  ],
  "permissions": [
    "core:window:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "core:window:allow-close",
    "allow-get-theme",
    "allow-preview-get",
    "allow-preview-apply",
    "allow-preview-close",
    "allow-preview-run"
  ]
}
