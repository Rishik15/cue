{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "preview",
  "description": "The preview window: its own four commands and the settings read for the theme, nothing else",
  "windows": [
    "preview"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "allow-get-settings",
    "allow-preview-get",
    "allow-preview-apply",
    "allow-preview-close",
    "allow-preview-choose"
  ]
}
