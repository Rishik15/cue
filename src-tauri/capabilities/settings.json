{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "The settings window: every command the settings pages use, and nothing for the preview",
  "windows": [
    "settings"
  ],
  "permissions": [
    "core:window:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:app:allow-version",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "allow-get-shortcut",
    "allow-shortcut-record",
    "allow-shortcut-hook-check",
    "allow-reset-shortcut",
    "allow-get-settings",
    "allow-set-setting",
    "allow-get-autostart",
    "allow-set-autostart",
    "allow-remove-app-data",
    "allow-take-start-page",
    "allow-open-link",
    "allow-check-update",
    "allow-update-status",
    "allow-install-update",
    "allow-list-actions",
    "allow-list-microphones",
    "allow-get-rules",
    "allow-save-rules",
    "allow-test-rules",
    "allow-rule-log",
    "allow-get-stats",
    "allow-list-models",
    "allow-download-model",
    "allow-cancel-download",
    "allow-delete-model",
    "allow-list-ocr-languages",
    "allow-list-apps",
    "allow-list-snippets",
    "allow-save-snippet",
    "allow-delete-snippet",
    "allow-import-snippets",
    "allow-export-snippets",
    "allow-add-starter-snippets",
    "allow-snippet-preview",
    "allow-save-folder",
    "allow-delete-folder",
    "allow-read-clipboard-text",
    "allow-list-words",
    "allow-delete-word"
  ]
}
