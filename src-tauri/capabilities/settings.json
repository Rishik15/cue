{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "The settings window: every command the settings pages use, and nothing for the preview",
  "windows": [
    "settings"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "allow-get-shortcut",
    "allow-shortcut-record",
    "allow-reset-shortcut",
    "allow-get-settings",
    "allow-set-setting",
    "allow-get-autostart",
    "allow-set-autostart",
    "allow-remove-app-data",
    "allow-open-link",
    "allow-list-actions",
    "allow-list-microphones",
    "allow-get-rules",
    "allow-save-rules",
    "allow-test-rules",
    "allow-rule-log",
    "allow-get-stats",
    "allow-list-models",
    "allow-download-model",
    "allow-cancel-download",
    "allow-delete-model"
  ]
}
