{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "define",
  "description": "The dictionary popup: its own commands and the settings read for the theme, nothing else",
  "windows": [
    "define"
  ],
  "permissions": [
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-close",
    "allow-get-theme",
    "allow-define-get",
    "allow-define-fit",
    "allow-define-save",
    "allow-define-close"
  ]
}
