{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dictionary",
  "description": "The dictionary window: the open event and its own commands, nothing else",
  "windows": [
    "dictionary-*"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-dict-ready",
    "allow-dict-search",
    "allow-dict-define",
    "allow-dict-seen",
    "allow-dict-place",
    "allow-dict-close",
    "allow-dict-download"
  ]
}
