{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cue",
  "version": "0.2.0",
  "identifier": "dev.cue.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "Cue",
        "width": 797,
        "height": 565,
        "minWidth": 640,
        "minHeight": 420,
        "decorations": false,
        "shadow": true,
        "center": true,
        "create": false,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOCR,msSmartScreenProtection --in-process-gpu --renderer-process-limit=1"
      },
      {
        "label": "preview",
        "title": "Cue Preview",
        "url": "preview.html",
        "width": 750,
        "height": 474,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "acrylic"
          ],
          "state": "active"
        },
        "shadow": true,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "create": false,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOCR,msSmartScreenProtection --in-process-gpu --renderer-process-limit=1"
      },
      {
        "label": "ask",
        "title": "Cue",
        "url": "ask.html",
        "width": 440,
        "height": 200,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "acrylic"
          ],
          "state": "active"
        },
        "shadow": true,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "create": false,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOCR,msSmartScreenProtection --in-process-gpu --renderer-process-limit=1"
      },
      {
        "label": "notes",
        "title": "Cue Note",
        "url": "notes.html",
        "width": 340,
        "height": 360,
        "minWidth": 240,
        "minHeight": 160,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "create": false,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOCR,msSmartScreenProtection --in-process-gpu --renderer-process-limit=1"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Rishik",
    "copyright": "Copyright (c) 2026 Rishik",
    "licenseFile": "../LICENSE",
    "shortDescription": "Local desktop utility for dictating, capturing, editing, and reusing text.",
    "category": "Productivity",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installerHooks": "windows/hooks.nsh",
        "installMode": "both",
        "displayLanguageSelector": false
      }
    }
  }
}