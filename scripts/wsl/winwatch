#!/usr/bin/env bash
# File: scripts/wsl/winwatch
# Purpose: keep the Windows copy in step with the repo while `winsync live` runs: when a watched file changes, run `winsync sync`. Polls once a second (WSL has no file events for this tree).
# Contents: the change-detection loop over the watched files.
# Started and stopped by winsync; not meant to be run by hand.
cd "$(dirname "$0")/../.."
stamp=$(mktemp)
trap 'rm -f "$stamp"' EXIT
while sleep 1; do
  changed=$(find src src-tauri/src src-tauri/capabilities src-tauri/Cargo.toml src-tauri/tauri.conf.json src-tauri/build.rs index.html preview.html ask.html notes.html break.html vite.config.ts package.json -newer "$stamp" -print -quit 2>/dev/null)
  [ -z "$changed" ] && continue
  touch "$stamp"
  scripts/wsl/winsync sync >/dev/null 2>&1
done
