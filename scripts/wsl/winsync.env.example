# File: scripts/wsl/winsync.env.example
# Purpose: copy to scripts/wsl/winsync.env (git-ignored) to change where winsync puts the Windows copy and which tools it uses. Every line is optional.
# Contents: DEST_WSL, CUE_LAB, LLVM_DIR, POWERSHELL.
# Folder on the Windows side that receives the repo, seen from WSL. Default: /mnt/c/dev/cue
DEST_WSL=/mnt/c/dev/cue
# Where the maintainer-only lab fixtures (models, word-error-rate clips) live on Windows. Default: cue-lab in the Windows user folder.
CUE_LAB=
# LLVM with clang-cl for scripts/wsl/clippy-wsl (cargo-xwin). Default: $HOME/tools/LLVM-19.1.7-Linux-X64
LLVM_DIR=
# Path of powershell.exe if it is not on the WSL PATH. Default: /mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe
POWERSHELL=
