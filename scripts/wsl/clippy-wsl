#!/usr/bin/env bash
# Purpose: run clippy (and so a full type check, tests included) for the Windows target from WSL, without syncing to Windows.
# Needs cargo-xwin and an LLVM (clang-cl) at ~/tools/LLVM-19.1.7-Linux-X64 (or LLVM_DIR in winsync.env). Usage: scripts/wsl/clippy-wsl
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
[ -f "$here/winsync.env" ] && . "$here/winsync.env"
export PATH="${LLVM_DIR:-$HOME/tools/LLVM-19.1.7-Linux-X64}/bin:$PATH"
cd "$(dirname "$0")/../../src-tauri"
cargo fmt --check
cargo xwin clippy --target x86_64-pc-windows-msvc --all-targets -- -D warnings
